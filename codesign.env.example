# Copy to codesign.env (gitignored) to sign with a stable identity.
#
# SpaceBadge needs Accessibility to run its event tap. TCC keys the grant to
# the code signature, so an adhoc-signed build loses the grant on every
# `make install` and you re-approve in System Settings each time.
#
# IDENTITY is the SHA-1 from `security find-identity -v -p codesigning`.
# TEAM_OU is the OU field of that cert:
#   security find-certificate -c "<cert common name>" -p | openssl x509 -noout -subject
#
# The designated requirement is pinned to the team OU rather than the default,
# which embeds the leaf CN's per-cert token. Apple rotates that token on cert
# renewal, which would drop the grant once a year.

export SPACETOOLS_CODESIGN_IDENTITY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
export SPACETOOLS_TEAM_OU="XXXXXXXXXX"
